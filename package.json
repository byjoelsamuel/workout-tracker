{
  "name": "workout-tracker",
  "productName": "Tsyoku-naru",
  "version": "1.5.0",
  "description": "A private workout tracker: log every set, see which muscles you've trained lately, and plan full-body sessions.",
  "type": "module",
  "main": "desktop/main.cjs",
  "desktopName": "tsyoku-naru.desktop",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:linux": "vite build && electron-builder --linux --publish never",
    "android:sync": "vite build && cap sync android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byjoelsamuel/workout-tracker.git"
  },
  "keywords": [],
  "author": {
    "name": "Joel Samuel",
    "url": "https://github.com/byjoelsamuel"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/byjoelsamuel/workout-tracker/issues"
  },
  "homepage": "https://github.com/byjoelsamuel/workout-tracker#readme",
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource-variable/rubik": "^5.3.0",
    "motion": "^13.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "vite": "^8.2.1",
    "vitest": "^5.1.0"
  }
}
